{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo",
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "RemoteSigned",
              "-File",
              "__SOUND_SCRIPT__"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
